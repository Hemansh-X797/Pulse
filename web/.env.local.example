# Copy this file to .env.local and fill in real values.
# Vite -> Next.js migration note: Vite used the VITE_ prefix for
# client-exposed vars; Next.js uses NEXT_PUBLIC_ instead. The values
# themselves are unchanged from your old .env.local — just the key names.

NEXT_PUBLIC_SUPABASE_URL=https://zfuctxrbvdvrkxagqtvg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets (never prefix these with NEXT_PUBLIC_) ---
# These stay server-side: used by Render cron jobs / API routes, never
# shipped to the browser bundle.
PALSPACE_GOOGLE_CLIENT_ID=634020891022-okgtr94mf927djeeik12l29m2menu7l4.apps.googleusercontent.com
PALSPACE_GOOGLE_CLIENT_SECRET=
PALSPACE_GOOGLE_REDIRECT_URI=https://palspace-backend.onrender.com/auth/google/callback
PALSPACE_DISCORD_CLIENT_ID=1537407011501908028
PALSPACE_DISCORD_CLIENT_SECRET=
PALSPACE_DISCORD_REDIRECT_URI=https://palspace-backend.onrender.com/auth/discord/callback
PALSPACE_FRONTEND_URL=https://palspace.vercel.app

# --- Phone login: intentionally not included ---
# There's no way to make this actually free: every SMS provider (Twilio,
# Vonage, AWS SNS, MessageBird, Supabase's own phone-auth integrations —
# all of them) is a thin wrapper over the same thing, carriers charging a
# per-message termination fee. That's not a markup Twilio invented; it's
# the underlying telecom cost, so "build your own" can't avoid it either.
# Free-tier trials exist but they're small (Twilio's is a few dollars of
# trial credit, not an ongoing free tier) and it stays a per-message cost
# forever after. Dropped from scope rather than shipped as something that
# quietly starts costing you money. Email OTP (fully free via Supabase
# Auth) is a real substitute if you want a second passwordless option —
# flag it if you want that built instead.

# --- Analytics (optional) ---
# Google Analytics 4 measurement ID (e.g. G-XXXXXXX). Leave blank to
# disable — the GA script tags simply don't render if this is unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Voice calls (WebRTC) ---
# STUN is free/public and already built in — no config needed for
# that. TURN is only needed as a relay fallback for connections that
# can't establish direct peer-to-peer (symmetric NATs, some corporate
# firewalls — roughly 10-20% of real-world connections). Calls work
# without this for most people; leave blank to skip it, or get a free
# tier from Metered/OpenRelay (https://www.metered.ca/tools/openrelay/)
# or Cloudflare Calls and fill in all three.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# --- GIF search (chat compose bar) ---
# Both genuinely free. Set either or both — if both are set, the
# picker shows a Giphy/Tenor tab switcher; with just one, it's used
# silently with no switcher shown.
# Giphy: get a key at developers.giphy.com. Without this set, that tab
# shows a message telling you to add it, rather than silently failing.
NEXT_PUBLIC_GIPHY_API_KEY=
# Tenor (Google): get a key at developers.google.com/tenor.
NEXT_PUBLIC_TENOR_API_KEY=
