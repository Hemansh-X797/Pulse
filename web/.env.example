# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).
#
# The anon key is safe to expose in a client bundle by design — see
# src/lib/supabase.ts for why (short version: Row Level Security in
# supabase/schema.sql is what actually enforces access, not this key
# being secret).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
